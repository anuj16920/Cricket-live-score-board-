# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SPORTMONKS_API_TOKEN: Optional Sportmonks Cricket API v2.0 token (server-side only).
# Leave empty to run BOUNDARYLIVE in clearly labeled DEMO MODE with fictional teams.
SPORTMONKS_API_TOKEN=""

# SPORTMONKS_BASE_URL: Base URL for Sportmonks Cricket API v2.0.
SPORTMONKS_BASE_URL="https://cricket.sportmonks.com/api/v2.0"
